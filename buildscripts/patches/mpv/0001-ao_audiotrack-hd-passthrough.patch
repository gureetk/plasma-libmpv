             AudioTrack.clazz,
@@ -673,7 +713,10 @@ static int init(struct ao *ao)
         p->format = AudioFormat.ENCODING_PCM_16BIT;
     }
 
-    if (AudioTrack.getNativeOutputSampleRate) {
+    // IEC 61937 has to go out at the rate the spdif decoder chose for the
+    // format it carries: 192 kHz for E-AC-3, TrueHD and DTS-HD. Capped at the
+    // native output rate, it no longer matches, and mpv decodes it instead.
+    if (!af_fmt_is_spdif(ao->format) && AudioTrack.getNativeOutputSampleRate) {
         jint samplerate = MP_JNI_CALL_STATIC_INT(
             AudioTrack.clazz,
             AudioTrack.getNativeOutputSampleRate,
@@ -711,7 +754,26 @@ static int init(struct ao *ao)
     };
     static_assert(MP_ARRAY_SIZE(layout_map) == MP_ARRAY_SIZE(layouts), "");
     if (p->format == AudioFormat.ENCODING_IEC61937) {
-        p->channel_config = AudioFormat.CHANNEL_OUT_STEREO;
+        // IEC 61937 is carried on 2 channels, or on 8 for the high bit rate
+        // formats (TrueHD and DTS-HD MA), as the spdif decoder lays it out.
+        if (ao->channels.num == 2) {
+            p->channel_config = AudioFormat.CHANNEL_OUT_STEREO;
+        } else if (ao->channels.num == 8 && AudioFormat.CHANNEL_OUT_7POINT1_SURROUND) {
+            p->channel_config = AudioFormat.CHANNEL_OUT_7POINT1_SURROUND;
+        } else {
+            MP_ERR(ao, "spdif passthrough over %d channels not supported\n",
+                   ao->channels.num);
+            goto error;
+        }
+        // Beyond 48 kHz stereo, ask first, so that an output that can't take
+        // it is refused here and mpv falls back to PCM.
+        if ((p->samplerate > 48000 || ao->channels.num > 2) &&
+            !AudioTrack_isDirectPlaybackSupported(ao))
+        {
+            MP_ERR(ao, "this output can't pass %s through (%d Hz, %d channels)\n",
+                   af_fmt_to_str(ao->format), p->samplerate, ao->channels.num);
+            goto error;
+        }
     } else {
         struct mp_chmap_sel sel = {0};
         for (int i = 0; i < MP_ARRAY_SIZE(layouts); i++) {
